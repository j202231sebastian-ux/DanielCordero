---
---

<section class="relative bg-[#fcf9f5] py-2 px-4 sm:px-6 lg:px-8 overflow-hidden font-sans" id="testimonios">
  <!-- Contenedor principal -->
  <div class="max-w-7xl mx-auto text-center relative z-10">
    
    <!-- Encabezado -->
    <span class="text-xs uppercase tracking-widest text-[#a38a70] font-semibold block mb-2">
      Casos de Éxito
    </span>
    <h2 class="text-3xl md:text-4xl font-serif text-[#1e3a5f] font-normal mb-2">
      Ellas ya transformaron su vida
    </h2>
    
    <!-- Divisor decorativo simple (puedes reemplazarlo por un SVG de ramita) -->
    <div class="flex justify-center items-center my-4 space-x-2">
      <div class="w-8 h-[1px] bg-[#a38a70]"></div>
      <span class="text-[#a38a70] text-lg">🌿</span>
      <div class="w-8 h-[1px] bg-[#a38a70]"></div>
    </div>

    <!-- Grid de Testimonios -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-5 text-left">
      
      <!-- Tarjeta 1 -->
      <div class="bg-white/60 backdrop-blur-sm border border-[#f0eae1] rounded-2xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <!-- Icono de comillas -->
          <span class="text-4xl font-serif text-[#cfa87b] block leading-none mb-2">“</span>
          <p class="text-gray-700 text-sm leading-relaxed mb-6">
            "Este programa me ayudó a sanar heridas que cargaba por años. Hoy tengo paz y he visto cambios maravillosos en mis hijos."
          </p>
        </div>
        <!-- Autor -->
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-300 overflow-hidden border border-gray-200">
            <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=100&auto=format&fit=crop&q=80" alt="María Fernández" class="w-full h-full object-cover">
          </div>
          <div class="pl-2">
            <h4 class="text-sm font-bold text-gray-900">María Fernández</h4>
            <p class="text-xs text-gray-500">Madre de 2 hijos</p>
          </div>
        </div>
      </div>

      <!-- Tarjeta 2 -->
      <div class="bg-white/60 backdrop-blur-sm border border-[#f0eae1] rounded-2xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-4xl font-serif text-[#cfa87b] block leading-none mb-2">“</span>
          <p class="text-gray-700 text-sm leading-relaxed mb-6">
            "Aprendí a confiar en Dios y en mí misma. Mi relación con mi esposo y mis hijos mejoró como nunca antes."
          </p>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-300 overflow-hidden border border-gray-200">
            <img src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=100&auto=format&fit=crop&q=80" alt="Laura Gómez" class="w-full h-full object-cover">
          </div>
          <div class="pl-2">
            <h4 class="text-sm font-bold text-gray-900">Laura Gómez</h4>
            <p class="text-xs text-gray-500">Madre de 3 hijos</p>
          </div>
        </div>
      </div>

      <!-- Tarjeta 3 -->
      <div class="bg-white/60 backdrop-blur-sm border border-[#f0eae1] rounded-2xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-4xl font-serif text-[#cfa87b] block leading-none mb-2">“</span>
          <p class="text-gray-700 text-sm leading-relaxed mb-6">
            "Daniel habla con tanta verdad y amor que te hace sentir acompañada en todo el proceso."
          </p>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-300 overflow-hidden border border-gray-200">
            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=100&auto=format&fit=crop&q=80" alt="Andrea Ramírez" class="w-full h-full object-cover">
          </div>
          <div class="pl-2">
            <h4 class="text-sm font-bold text-gray-900">Andrea Ramírez</h4>
            <p class="text-xs text-gray-500">Madre de 2 hijos</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Botón de Acción y Subtexto -->
    <div class="mt-8">
      <button class="bg-[#c85a2b] hover:bg-[#b04f25] text-white font-bold uppercase tracking-wider text-sm md:text-base py-4 px-8 md:px-12 rounded-lg transition-colors shadow-md inline-block">
        Quiero transformar mi vida
      </button>
      <p class="text-gray-600 text-sm md:text-base mt-4 font-light">
        Únete a cientos de madres que ya están viviendo su mejor versión.
      </p>
    </div>
  </div>

</section>