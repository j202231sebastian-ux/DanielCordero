---

---

<section class="mx-auto w-full max-w-3xl rounded-[1.25rem] alt-bg p-8 shadow-[0_25px_60px_rgba(15,23,42,0.12)]">
	<p class="text-center text-lg font-bold uppercase tracking-[0.35em] text-sky-500 md:text-xl mb-8">
		Ponte en contacto
	</p>

	<form
		class="space-y-6"
		id="email-form"
	>
		<div class="space-y-2">
			<label
				for="name"
				class="block text-sm font-semibold tracking-[0.12em] text-slate-700 uppercase"
			>
				Nombre
			</label>
			<input
				type="text"
				id="name"
				name="name"
				required
				placeholder="Tu nombre"
				class="w-full rounded-lg border border-[rgba(43,42,40,0.06)] bg-[var(--beige)] px-4 py-3 text-[var(--negro)] transition duration-300 outline-none placeholder:text-[rgba(43,42,40,0.45)] focus:border-[var(--caramelo)] focus:ring-2 focus:ring-[var(--caramelo)]/20"
			/>
		</div>

		<div class="space-y-2">
			<label
				for="email"
				class="block text-sm font-semibold tracking-[0.12em] text-slate-700 uppercase"
			>
				Email
			</label>
			<input
				type="email"
				id="email"
				name="email"
				required
				placeholder="tu@email.com"
				class="w-full rounded-lg border border-[rgba(43,42,40,0.06)] bg-[var(--beige)] px-4 py-3 text-[var(--negro)] transition duration-300 outline-none placeholder:text-[rgba(43,42,40,0.45)] focus:border-[var(--caramelo)] focus:ring-2 focus:ring-[var(--caramelo)]/20"
			/>
		</div>

		<div class="space-y-2">
			<label
				for="message"
				class="block text-sm font-semibold tracking-[0.12em] text-slate-700 uppercase"
			>
				Mensaje
			</label>
			<textarea
				id="message"
				name="message"
				rows="5"
				required
				placeholder="Escribe tu mensaje aquí..."
				class="min-h-[140px] w-full rounded-lg border border-[rgba(43,42,40,0.06)] bg-[var(--beige)] px-4 py-3 text-[var(--negro)] transition duration-300 outline-none placeholder:text-[rgba(43,42,40,0.45)] focus:border-[var(--caramelo)] focus:ring-2 focus:ring-[var(--caramelo)]/20 resize-none"
			></textarea>
		</div>

		<button
			type="submit"
			class="w-full rounded-lg border-2 border-[rgba(43,42,40,0.06)] bg-[var(--caramelo)] px-6 py-3 font-bold text-[var(--marfil)] transition-all duration-300 hover:bg-[var(--dorado)] hover:border-[rgba(43,42,40,0.08)] hover:-translate-y-0.5 hover:shadow-md"
		>
			Enviar mensaje
		</button>
	</form>
</section>

<script>
	const formulario = document.getElementById("email-form")! as HTMLFormElement | null;

	formulario?.addEventListener("submit", async (e) => {
		e.preventDefault();

		const data = new FormData(formulario);
		const response = await fetch("https://formspree.io/f/xvzylyqw", {
			method: "POST",
			body: data,
			headers: {
				Accept: "application/json",
			},
		});

		if (response.ok) {
			alert("¡Gracias! Mensaje enviado.");
			formulario?.reset();
		} else {
			alert("Hubo un error al enviar.");
		}
	});
</script>
