---
---

<section class="w-full bg-[#1e3a5f] text-white overflow-hidden font-sans relative min-h-[350px]" id="contacto">
  <!-- 1. Contenedor de la Imagen: Absoluto, pegado abajo a la izquierda -->
  <div class="absolute bottom-0 left-0 hidden md:block w-5/12 max-w-[520px] z-10">
  <img 
    src="/libro.png" 
    alt="Devocional Dios tiene un propósito para ti" 
    class="w-full h-auto object-contain object-left-bottom block"
  />
</div>

  <!-- 2. Contenedor del Contenido: Grid corregido -->
  <div class="max-w-7xl mx-auto px-4 pt-12 pb-12 md:pt-12 md:pb-0 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    
    <!-- Espacio reservado en desktop para que el texto no pise la imagen -->
    <div class="hidden md:block md:col-span-4 h-full"></div>

    <!-- Vista móvil de la imagen (Opcional, si quieres que aparezca arriba en celular) -->
    <div class="block md:hidden col-span-1 flex justify-center">
      <img 
        src="/libro.png" 
        alt="Devocional Dios tiene un propósito para ti" 
        class="w-full h-auto max-w-[280px]"
      />
    </div>

    <!-- Bloque de Texto e Información -->
    <div class="col-span-1 md:col-span-4 space-y-4 z-20">
      <span class="text-xs uppercase tracking-widest text-slate-300 font-semibold block">
        Recurso Gratuito
      </span>
      <h2 class="text-3xl md:text-4xl font-serif font-normal leading-tight">
        Descarga gratis tu devocional
      </h2>
      <p class="text-slate-200 text-sm md:text-base">
        Dios tiene un propósito para ti y tu familia.
      </p>
      
      <!-- Lista de beneficios -->
      <ul class="space-y-2 text-sm text-slate-200">
        <li class="flex items-start space-x-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Reflexiones diarias basadas en la Biblia</span>
        </li>
        <li class="flex items-start space-x-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Fortalece tu fe y tu mentalidad</span>
        </li>
        <li class="flex items-start space-x-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Encuentra dirección y paz en tu día a día</span>
        </li>
      </ul>
    </div>

    <!-- Bloque del Formulario de Captura -->
    <div class="col-span-1 md:col-span-4 w-full max-w-md mx-auto md:max-w-none flex flex-col justify-center pb-8 md:pb-12 z-20">
      <form class="space-y-3 relative" id="email-form">
        <div>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="Escribe tu correo"
            class="w-full rounded-lg border border-transparent bg-[#fdfaf6] px-4 py-3.5 text-gray-800 transition duration-300 outline-none placeholder:text-gray-400 focus:bg-white text-base"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-[#c85a2b] hover:bg-[#b04f25] px-6 py-3.5 font-bold text-white uppercase tracking-wider text-sm md:text-base transition-all duration-300 shadow-md flex items-center justify-center relative group"
        >
          Quiero mi devocional gratis
        </button>
      </form>

      <!-- Garantía de Privacidad -->
      <div class="flex items-center justify-center space-x-1.5 mt-3 text-xs text-slate-300">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <span>Tu información está 100% segura.</span>
      </div>
    </div>

  </div>
</section>

<script>
  // Selección segura con tipado para TypeScript en Astro
  const formulario = document.getElementById("email-form") as HTMLFormElement | null;

  formulario?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const data = new FormData(formulario);
    
    try {
      const response = await fetch("https://formspree.io/f/xvzylyqw", {
        method: "POST",
        body: data,
        headers: {
          Accept: "application/json",
        },
      });

      if (response.ok) {
        alert("¡Gracias! Tu devocional está en camino.");
        formulario.reset();
      } else {
        alert("Hubo un error al procesar tu solicitud.");
      }
    } catch (error) {
      alert("No se pudo conectar con el servidor.");
    }
  });
</script>

