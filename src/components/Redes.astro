<div class="redes-menu">
  <button class="menu-toggle btn-action" id="menuToggle" aria-haspopup="true" aria-expanded="false">
    <span class="toggle-text">Nuestras Redes Sociales</span>
    <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="redes-container" id="redesContainer">
    <a href="https://www.facebook.com/share/1EgyVP31YV/" target="_blank" rel="noopener noreferrer" class="social-btn facebook">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
      Facebook
    </a>

    <a href="https://www.tiktok.com/@daniel.cordero.oficial?_r=1&_t=ZS-96kummscQMf" target="_blank" rel="noopener noreferrer" class="social-btn tiktok">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19.498 3.71h-3.185v12.019c0 1.708-1.388 3.097-3.097 3.097-1.708 0-3.097-1.389-3.097-3.097 0-1.708 1.389-3.097 3.097-3.097.496 0 .966.119 1.381.331V5.404a6.076 6.076 0 0 0-1.381-.168C7.735 5.236 4.773 8.198 4.773 11.929c0 3.731 2.962 6.693 6.693 6.693 3.731 0 6.693-2.962 6.693-6.693V8.618c1.296 1.003 2.922 1.594 4.639 1.594v-3.261c-.992 0-1.925-.29-2.708-.789z"/>
      </svg>
      TikTok
    </a>

    <a href="https://www.instagram.com/danielcordero_oficial?igsh=ZHB1ZXpoMHFoODJq" target="_blank" rel="noopener noreferrer" class="social-btn instagram">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
      Instagram
    </a>
  </div>
</div>

<style>
  .redes-menu {
    position: relative;
    display: inline-block;
    /* Controla el ancho total del componente desde aquí si lo deseas */
    width: 100%; 
    max-width: 320px; 
  }

  .menu-toggle {
    width: 100%;
    justify-content: center;
    font-size: 1rem;
    font-weight: 600;
    position: relative;
    padding-right: 2.5rem; /* espacio para la flecha */
    display: inline-flex;
    align-items: center;
  }

  /* Animación para la flecha */
  .chevron-icon {
    transition: transform 0.3s ease;
    color: #666;
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }

  /* Cuando el menú esté activo, la flecha girará 180 grados */
  .menu-toggle.active .chevron-icon {
    transform: translateY(-50%) rotate(180deg);
    color: #000;
  }

  .toggle-text {
    display: block;
    width: 100%;
    text-align: center;
  }

  .redes-container {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%; /* Se acopla exactamente al ancho del botón */
    margin-top: 6px;
    background-color: var(--gris);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: 8px;
    box-shadow: 0 8px 30px rgba(2,6,23,0.6);
    z-index: 1000;
    overflow: hidden; /* Para que los bordes redondeados afecten a los enlaces */
    transform-origin: top center;
    animation: slideDown 0.2s ease-out;
  }

  .redes-container.active {
    display: flex;
    flex-direction: column;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: scaleY(0.95);
    }
    to {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  .social-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    text-decoration: none;
    color: var(--marfil);
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s ease;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  .social-btn:last-child {
    border-bottom: none;
  }

  .social-btn:hover {
    background-color: rgba(245,241,234,0.04);
    padding-left: 24px; /* Efecto sutil de desplazamiento a la derecha */
    color: var(--marfil);
  }

  .social-btn.facebook:hover {
    color: var(--caramelo);
    background-color: rgba(183,134,82,0.06);
  }

  .social-btn.tiktok:hover {
    color: var(--caramelo);
    background-color: rgba(183,134,82,0.06);
  }

  .social-btn.instagram:hover {
    color: var(--caramelo);
    background-color: rgba(183,134,82,0.06);
  }

  .social-btn svg {
    flex-shrink: 0;
  }
</style>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const redesContainer = document.getElementById('redesContainer');

  menuToggle?.addEventListener('click', (e) => {
    e.stopPropagation(); 
    const isActive = redesContainer?.classList.toggle('active');
    
    // Añadimos/quitamos la clase al botón para rotar la flecha
    menuToggle.classList.toggle('active');
    
    // Buena práctica de accesibilidad
    menuToggle.setAttribute('aria-expanded', String(isActive));
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    if (target && !target.closest('.redes-menu')) {
      redesContainer?.classList.remove('active');
      menuToggle?.classList.remove('active');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>