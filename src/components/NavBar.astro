        <div class="flex items-center justify-between gap-2">
          <button class="bg-[#c2623a] text-white px-4 py-3 rounded-md text-sm font-semibold uppercase tracking-wider hover:bg-[#a15130] transition-colors shadow-sm whitespace-nowrap">
            CONOCE MI PROGRAMA
          </button>

          <button
            id="menu-toggle"
            class="text-[#1f2937] hover:text-[#c2623a] p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-[#c2623a]"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
