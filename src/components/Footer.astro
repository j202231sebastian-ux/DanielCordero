---
// Footer.astro
// Puedes cambiar el año dinámicamente si lo deseas, o dejar el fijo de la imagen
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#fdfaf6] text-[#1e3a5f] font-sans py-12 border-t border-gray-200/50">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-4 items-start">
    
    <!-- Columna 1: Logo y Copyright (Desktop) -->
    <div class="col-span-1 md:col-span-4 flex flex-col justify-between h-full space-y-6 md:space-y-12">
      <div>
        <img 
          src="/logo.png" 
          alt="Daniel Cordero - Coach, Mentor, Creador" 
          class="h-auto w-48 object-contain"
        />
      </div>
      <p class="text-xs text-gray-500 hidden md:block">
        &copy; {currentYear} Daniel Cordero. Todos los derechos reservados.
      </p>
    </div>

    <!-- Columna 2: Enlaces -->
    <div class="col-span-1 md:col-span-2 space-y-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-[#1e3a5f]">
        Enlaces
      </h3>
      <ul class="space-y-1.5 text-sm text-gray-600 font-medium">
        <li><a href="#inicio" class="hover:text-[#c85a2b] transition-colors">Inicio</a></li>
        <li><a href="#sobre-mi" class="hover:text-[#c85a2b] transition-colors">Sobre mí</a></li>
        <li><a href="#recursos" class="hover:text-[#c85a2b] transition-colors">Recursos gratuitos</a></li>
        <li><a href="#testimonios" class="hover:text-[#c85a2b] transition-colors">Testimonios</a></li>
        <li><a href="#contacto" class="hover:text-[#c85a2b] transition-colors">Contacto</a></li>
      </ul>
    </div>

    <!-- Columna 3: Sígueme (Redes Sociales) -->
    <div class="col-span-1 md:col-span-2 space-y-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-[#1e3a5f]">
        Sígueme
      </h3>
      <div class="flex items-center space-x-4">
        <!-- TikTok -->
        <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="text-[#1e3a5f] hover:text-[#c85a2b] transition-colors">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.525.229a8.175 8.175 0 0 1 4.542 2.625 7.152 7.152 0 0 0-2.167 4.125h.001c.067.416.146.828.243 1.236a8.21 8.21 0 0 0 5.431-2.454v4.542a12.44 12.44 0 0 1-5.43-1.343v6.33a7.333 7.333 0 1 1-7.333-7.333c.366 0 .723.027 1.073.078V12.27a3.16 3.16 0 1 0-.14 4.526V10.22a7.31 7.31 0 0 1 3.79-10c-.01 0-.02-.001-.03-.001V.23h-.001z"/>
          </svg>
        </a>
        <!-- Instagram -->
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-[#1e3a5f] hover:text-[#c85a2b] transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <!-- YouTube -->
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="text-[#1e3a5f] hover:text-[#c85a2b] transition-colors">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.517 3.545 12 3.545 12 3.545s-7.517 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.871.507 9.388.507 9.388.507s7.517 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
        <!-- Facebook -->
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-[#1e3a5f] hover:text-[#c85a2b] transition-colors">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Columna 4: Contáctame y Enlaces Legales -->
    <div class="col-span-1 md:col-span-4 flex flex-col justify-between h-full space-y-6 md:space-y-12">
      <div class="space-y-2.5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[#1e3a5f]">
          Contáctame
        </h3>
        <div class="space-y-2 text-sm text-gray-700 font-medium">
          <!-- Email -->
          <a href="mailto:hola@danielcordero.com" class="flex items-center space-x-2 hover:text-[#c85a2b] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span>hola@danielcordero.com</span>
          </a>
          <!-- WhatsApp -->
          <a href="https://wa.me/521234567890" target="_blank" rel="noopener noreferrer" class="flex items-center space-x-2 hover:text-[#c85a2b] transition-colors">
            <svg class="w-4 h-4 stroke-current" fill="none" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span>+52 123 456 7890</span>
          </a>
        </div>
      </div>

      <!-- Enlaces legales en Desktop -->
      <div class="hidden md:flex items-center space-x-6 text-xs text-gray-500">
        <a href="#politica" class="hover:text-gray-700 transition-colors">Política de privacidad</a>
        <a href="#terminos" class="hover:text-gray-700 transition-colors">Términos y condiciones</a>
      </div>
    </div>

    <!-- Copyright y Legales para Vista Móvil (Para que mantenga coherencia en pantallas chicas) -->
    <div class="col-span-1 md:hidden pt-6 border-t border-gray-200 space-y-3 text-center text-xs text-gray-500">
      <div class="flex justify-center space-x-4">
        <a href="#politica" class="hover:text-gray-700">Política de privacidad</a>
        <a href="#terminos" class="hover:text-gray-700">Términos y condiciones</a>
      </div>
      <p>&copy; {currentYear} Daniel Cordero. Todos los derechos reservados.</p>
    </div>

  </div>
</footer>